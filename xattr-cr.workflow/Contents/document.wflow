				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>LOG="$HOME/Library/Logs/xattr-cr-QuickAction.log"
mkdir -p "$(dirname "$LOG")" 2&gt;/dev/null || true
printf '%s start argc=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$#" &gt;&gt; "$LOG" 2&gt;/dev/null

if [ "$#" -eq 0 ]; then
    /usr/bin/logger -t xattr-cr-QuickAction "no input" 2&gt;/dev/null
    /usr/bin/osascript -e 'display notification "項目を受け取れませんでした" with title "xattr -cr"' &gt;/dev/null 2&gt;&amp;1 &amp;
    exit 1
fi

ok=0
failed=0
for item in "$@"; do
    if /usr/bin/xattr -cr "$item" 2&gt;&gt; "$LOG"; then
        ok=$((ok + 1))
        printf '%s OK %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$item" &gt;&gt; "$LOG" 2&gt;/dev/null
    else
        failed=$((failed + 1))
        printf '%s NG %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$item" &gt;&gt; "$LOG" 2&gt;/dev/null
    fi
done

/usr/bin/logger -t xattr-cr-QuickAction "complete ok=$ok failed=$failed" 2&gt;/dev/null
if [ "$failed" -gt 0 ]; then
    /usr/bin/osascript -e 'display notification "一部の項目で削除に失敗しました。ログを確認してください" with title "xattr -cr"' &gt;/dev/null 2&gt;&amp;1 &amp;
    exit 1
fi
/usr/bin/osascript -e 'display notification "拡張属性を削除しました" with title "xattr -cr"' &gt;/dev/null 2&gt;&amp;1 &amp;
exit 0</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string>#!/bin/zsh
LOG="$HOME/Library/Logs/xattr-cr-QuickAction.log"
mkdir -p "$(dirname "$LOG")" 2&gt;/dev/null || true
printf '%s start argc=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$#" &gt;&gt; "$LOG" 2&gt;/dev/null

if [ "$#" -eq 0 ]; then
    /usr/bin/logger -t xattr-cr-QuickAction "no input" 2&gt;/dev/null
    /usr/bin/osascript -e 'display notification "項目を受け取れませんでした" with title "xattr -cr"' &gt;/dev/null 2&gt;&amp;1 &amp;
    exit 1
fi

ok=0
failed=0
for item in "$@"; do
    if /usr/bin/xattr -cr "$item" 2&gt;&gt; "$LOG"; then
        ok=$((ok + 1))
        printf '%s OK %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$item" &gt;&gt; "$LOG" 2&gt;/dev/null
    else
        failed=$((failed + 1))
        printf '%s NG %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$item" &gt;&gt; "$LOG" 2&gt;/dev/null
    fi
done

/usr/bin/logger -t xattr-cr-QuickAction "complete ok=$ok failed=$failed" 2&gt;/dev/null
if [ "$failed" -gt 0 ]; then
    /usr/bin/osascript -e 'display notification "一部の項目で削除に失敗しました。ログを確認してください" with title "xattr -cr"' &gt;/dev/null 2&gt;&amp;1 &amp;
    exit 1
fi
/usr/bin/osascript -e 'display notification "拡張属性を削除しました" with title "xattr -cr"' &gt;/dev/null 2&gt;&amp;1 &amp;
exit 0
</string>
